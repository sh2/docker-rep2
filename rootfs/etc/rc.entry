#!/bin/sh

mkdir -p /ext/conf /ext/data /ext/rep2/ic
cp -Rn /var/www/conf.orig/* /ext/conf/
cp -Rn /var/www/data.orig/* /ext/data/

sudo -u www-data php /var/www/scripts/ic2.php setup

chown -R www-data:www-data /ext

crond

php-fpm -D

# Generate Caddyfile
cat <<EOF > /etc/Caddyfile
:8443 {
    log {
        output stderr
    }
EOF
if [ -n "$REP2_TLS_CERT" ] && [ -n "$REP2_TLS_KEY" ]; then
    echo "    tls $REP2_TLS_CERT $REP2_TLS_KEY" >> /etc/Caddyfile
fi
cat <<EOF >> /etc/Caddyfile
    root * /var/www/rep2
    php_fastcgi 127.0.0.1:9000
    file_server

    @js_files {
        path *.js
    }
    header @js_files Content-Type "application/javascript; charset=Shift_JIS"
}
EOF

caddy start --config /etc/Caddyfile

while true; do
    rm -f /tmp/2chproxy.pid
    sudo -E -u nobody /usr/local/bin/2chproxy.pl -v -c /etc/2chproxy.conf
done
